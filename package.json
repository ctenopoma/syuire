{
  "name": "akaire-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @akaire/core && npm run build -w @akaire/local && npm run build -w @akaire/web",
    "typecheck": "tsc -b packages/core packages/local packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node packages/local/dist/cli.js serve"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
